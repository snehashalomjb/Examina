# Normalize line endings to LF in the repository regardless of the checkout
# platform's default. Stops the "LF will be replaced by CRLF" warning on every
# commit made from Windows, and keeps diffs free of whitespace-only noise.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.task binary
*.wasm binary
