# --- Application ---
APP_NAME="AI-Based Intelligent Examination Platform"
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Database ---
# Host port 5433 -> container 5432 (avoids clashing with a local Postgres on 5432)
DATABASE_URL=postgresql+psycopg://exam:exam@localhost:5433/examdb
TEST_DATABASE_URL=postgresql+psycopg://exam:exam@localhost:5434/examdb_test
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-production-please-use-a-64-char-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
EXAM_SESSION_TOKEN_EXPIRE_MINUTES=15
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# --- Object storage (MinIO / S3) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=exam-media
S3_REGION=us-east-1
S3_PRESIGN_EXPIRE_SECONDS=900

# --- Subjective grading ---
# stub = deterministic offline grader (no network, no API key).
# claude / openai = a real model; each needs its own key below and a matching GRADER_MODEL
# (e.g. claude-opus-5, or gpt-4o for openai).
GRADER_PROVIDER=stub
GRADER_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- OCR for handwritten answer scans (Tesseract) ---
# Install Tesseract and leave TESSERACT_CMD unset if it is on PATH. On Windows it usually
# is not: C:/Program Files/Tesseract-OCR/tesseract.exe
OCR_ENABLED=true
OCR_LANGUAGES=eng
# TESSERACT_CMD=

# --- Bootstrap admin (created by app.seed) ---
FIRST_ADMIN_EMAIL=admin@exam.edu
FIRST_ADMIN_PASSWORD=Admin@12345

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=../logs
